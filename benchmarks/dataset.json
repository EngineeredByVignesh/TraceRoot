{
  "version": 4,
  "evaluation": {
    "causeSpecificFixPatterns": [
      "\\b(roll.?back|revert|rotat\\w*|resiz\\w*|increas\\w*|releas\\w*|recycl\\w*|restart|reset|redeploy)\\b.{0,80}(deploy|version|credential|secret|pool|connection|service|pod|database)",
      "(pool|credential|deploy).{0,80}\\b(resiz\\w*|increas\\w*|rotat\\w*|recycl\\w*)\\b"
    ]
  },
  "cases": [
    {
      "id": "overlapping",
      "expectedReuse": { "renderer": true, "database": true },
      "failureMode": "bad_deploy,db_problem",
      "incidents": {
        "renderer": {
          "expectedMemoryTitle": "Order renderer regression after rollout",
          "rootPatterns": [
            "bad.deploy|bad deployment|renderer.*(crash|exception)|deploy.*(regression|bug)"
          ],
          "remediationPatterns": ["roll.?back|revert.*deploy|disable.*bad_deploy"],
          "memoryLabels": ["renderer"]
        },
        "database": {
          "expectedMemoryTitle": "orders-db pool exhaustion",
          "rootPatterns": [
            "(connection|database|db).*pool.*(exhaust|saturat)|pool.exhaust|db_problem"
          ],
          "remediationPatterns": [
            "(increase|resize|tune|restore|reset|release|recycl).*pool|pool.*(increase|resize|tune|restore|reset|release|recycl)|disable.*db_problem"
          ],
          "memoryLabels": ["database"]
        }
      },
      "alerts": [
        {
          "incident": "renderer",
          "name": "DemoServiceHighErrorRate",
          "component": "order-renderer",
          "summary": "Order renderer returns HTTP 500 for 65% of /api/orders requests."
        },
        {
          "incident": "renderer",
          "name": "DemoServiceHighLatency",
          "component": "order-renderer",
          "summary": "Order renderer /api/orders p95 latency exceeds 1 second after rollout v2."
        },
        {
          "incident": "database",
          "name": "DemoServiceDBConnectionErrors",
          "component": "database",
          "summary": "Independent /api/db probe cannot acquire orders-db connections; pool acquisition errors rising."
        },
        {
          "incident": "database",
          "name": "DemoServiceDBLatency",
          "component": "database",
          "summary": "orders-db connection acquisition p95 exceeds 1 second. The probe does not execute the order renderer."
        },
        {
          "incident": "renderer",
          "name": "DemoServicePodRestarts",
          "component": "order-renderer",
          "summary": "Demo-service restarted after renderer liveness failures following rollout v2."
        }
      ]
    },
    {
