# Authentication. Must match the agent's TOOL_API_TOKEN.
TOOL_API_TOKEN=dev-token

# Observability services exposed by IncidentLab.
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
LOKI_URL=http://localhost:3100

# Kubernetes access.
KUBECONFIG_CONTEXT=kind-incident-lab
K8S_NAMESPACE=incident-lab
K8S_DEPLOYMENT=demo-service
